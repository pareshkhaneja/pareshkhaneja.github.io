---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { siteConfig } from "@/config/site";
import { getProjects } from "@/lib/github";

const projects = await getProjects();
const featuredSet = new Set<string>(siteConfig.featuredRepos);
---

<BaseLayout>
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-14 sm:px-6 sm:pt-20">
    <div class="grid items-center gap-10 md:grid-cols-[1.2fr_0.8fr]">
      <div>
        <p class="mb-3 text-sm font-medium text-[var(--color-accent)]">{siteConfig.location}</p>
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{siteConfig.name}</h1>
        <p class="mt-3 text-xl text-[var(--color-muted)]">{siteConfig.title}</p>
        <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-muted)]">
          {siteConfig.description}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 items-center rounded-lg bg-[var(--color-accent)] px-4 text-sm font-medium text-[var(--color-accent-foreground)] hover:opacity-90"
          >
            Connect on LinkedIn
          </a>
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-10 items-center rounded-lg border border-[var(--color-border)] px-4 text-sm font-medium hover:bg-[var(--color-card)]"
          >
            View GitHub
          </a>
          <a
            href={siteConfig.resumeUrl}
            class="inline-flex h-10 items-center rounded-lg border border-[var(--color-border)] px-4 text-sm font-medium hover:bg-[var(--color-card)]"
          >
            Download CV
          </a>
        </div>
      </div>
      <div class="flex justify-center md:justify-end">
        <img
          src={siteConfig.avatarUrl}
          alt={`Portrait of ${siteConfig.name}`}
          width="280"
          height="280"
          loading="eager"
          class="h-56 w-56 rounded-3xl border border-[var(--color-border)] object-cover shadow-lg sm:h-64 sm:w-64"
        />
      </div>
    </div>
  </section>

  <section id="about" class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight">About</h2>
    <div class="mt-6 max-w-3xl space-y-4 text-base leading-relaxed text-[var(--color-muted)]">
      {siteConfig.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section id="expertise" class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight">Expertise</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        siteConfig.expertise.map((item) => (
          <article
            class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5 backdrop-blur-sm"
          >
            <h3 class="font-medium">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="projects" class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-2xl font-semibold tracking-tight">Projects</h2>
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-[var(--color-accent)] hover:underline"
      >
        All repositories
      </a>
    </div>
    <p class="mt-2 max-w-2xl text-sm text-[var(--color-muted)]">
      Public, non-archived repositories pulled from GitHub at build time.
    </p>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        projects.map((project) => (
          <ProjectCard project={project} featured={featuredSet.has(project.name)} />
        ))
      }
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-5xl px-4 py-14 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight">Get in touch</h2>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-[var(--color-muted)]">
      Interested in quality, automation, or collaboration? Reach out on LinkedIn or GitHub—I am
      happy to connect.
    </p>
    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href={siteConfig.social.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 items-center rounded-lg bg-[var(--color-accent)] px-4 text-sm font-medium text-[var(--color-accent-foreground)] hover:opacity-90"
      >
        LinkedIn
      </a>
      <a
        href={siteConfig.social.github}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-10 items-center rounded-lg border border-[var(--color-border)] px-4 text-sm font-medium hover:bg-[var(--color-card)]"
      >
        GitHub
      </a>
    </div>
  </section>
</BaseLayout>
