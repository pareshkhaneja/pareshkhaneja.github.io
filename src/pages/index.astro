---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CompanyLogo from "@/components/CompanyLogo.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { siteConfig } from "@/config/site";

const fp = siteConfig.featuredProject;
const toneMap = {
  blue: "bg-blue-50 text-blue-600",
  green: "bg-emerald-50 text-emerald-600",
  purple: "bg-violet-50 text-violet-600",
  orange: "bg-orange-50 text-orange-600",
  red: "bg-rose-50 text-rose-600",
} as const;
---

<BaseLayout>
  <div class="hero-grid-bg text-[var(--color-text-hero)]">
    <SiteHeader />
    <section id="home" class="mx-auto max-w-7xl px-4 pb-16 pt-8 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 xl:grid-cols-[minmax(0,1fr)_280px_260px]">
        <div id="about">
          <div class="mb-6 flex flex-wrap items-center gap-3 text-sm text-slate-300">
            <span class="inline-flex items-center gap-1.5">
              <span aria-hidden="true">📍</span>
              {siteConfig.location}
            </span>
            <span
              class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-300"
            >
              <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
              {siteConfig.status}
            </span>
          </div>

          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl">
            <span class="gradient-name">{siteConfig.name}</span>
          </h1>
          <p class="mt-3 text-lg font-medium text-slate-200 sm:text-xl">{siteConfig.title}</p>
          <p class="mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-text-hero-muted)]">
            {siteConfig.heroBio}
          </p>

          <div class="mt-8 flex flex-wrap gap-2">
            {
              siteConfig.skillTags.map((tag) => (
                <span class="pill-dark rounded-full px-3 py-1.5 text-xs font-medium">{tag}</span>
              ))
            }
          </div>

          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href={siteConfig.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-primary)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--color-primary-hover)]"
            >
              Connect on LinkedIn <span aria-hidden="true">→</span>
            </a>
            <a
              href={siteConfig.social.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center rounded-lg border border-[var(--color-hero-border)] px-5 py-2.5 text-sm font-medium text-slate-100 hover:bg-white/5"
            >
              View GitHub
            </a>
            <a
              href={siteConfig.resumeUrl}
              class="inline-flex items-center rounded-lg border border-[var(--color-hero-border)] px-5 py-2.5 text-sm font-medium text-slate-100 hover:bg-white/5"
            >
              Download Resume
            </a>
          </div>
        </div>

        <div class="flex justify-center xl:justify-end">
          <img
            src={siteConfig.portraitUrl}
            alt={`Portrait of ${siteConfig.name}`}
            width="280"
            height="360"
            loading="eager"
            class="h-[320px] w-[240px] rounded-2xl border border-[var(--color-hero-border)] object-cover shadow-2xl sm:h-[360px] sm:w-[280px]"
          />
        </div>

        <aside class="space-y-3 xl:pt-4" aria-label="Highlights">
          {
            siteConfig.heroStats.map((stat) => (
              <div class="stat-card flex items-start gap-3 rounded-xl px-4 py-3">
                <span
                  class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-500/15 text-blue-300"
                  aria-hidden="true"
                >
                  ★
                </span>
                <p class="text-sm leading-snug text-slate-200">{stat.label}</p>
              </div>
            ))
          }
        </aside>
      </div>
    </section>
  </div>

  <section id="expertise" class="bg-[var(--color-page)] px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900">
            {siteConfig.expertise.title}
          </h2>
          <p class="mt-2 text-slate-600">{siteConfig.expertise.subtitle}</p>
        </div>
        <a href="#expertise" class="text-sm font-medium text-[var(--color-primary)] hover:underline">
          {siteConfig.expertise.linkLabel} →
        </a>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-5">
        {
          siteConfig.expertise.items.map((item) => (
            <article class="section-card rounded-2xl p-5">
              <div
                class:list={[
                  "mb-4 flex h-11 w-11 items-center justify-center rounded-xl text-lg",
                  toneMap[item.tone],
                ]}
                aria-hidden="true"
              >
                {item.icon === "bot"
                  ? "🤖"
                  : item.icon === "database"
                    ? "🗄️"
                    : item.icon === "cog"
                      ? "⚙️"
                      : item.icon === "chart"
                        ? "📊"
                        : "☁️"}
              </div>
              <h3 class="font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="project" class="bg-[var(--color-page)] px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-slate-900">{fp.title}</h2>
          <p class="mt-2 text-slate-600">{fp.subtitle}</p>
        </div>
        <a
          href={fp.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm font-medium text-[var(--color-primary)] hover:underline"
        >
          {fp.linkLabel} →
        </a>
      </div>

      <article class="featured-panel mt-8 overflow-hidden rounded-3xl p-6 lg:p-8">
        <div class="grid gap-8 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,1.1fr)]">
          <div>
            <div class="flex items-center gap-3">
              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-blue-600"
                aria-hidden="true"
              >
                🗄️
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-bold text-slate-900">{fp.name}</h3>
                  <span
                    class="rounded-full bg-blue-100 px-2 py-0.5 text-xs font-semibold text-blue-700"
                    >Featured</span
                  >
                </div>
                <p class="text-sm font-medium text-slate-700">{fp.fullName}</p>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-slate-600">{fp.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                fp.tags.map((tag) => (
                  <span class="rounded-full bg-white px-2.5 py-1 text-xs font-medium text-slate-700 ring-1 ring-slate-200">
                    {tag}
                  </span>
                ))
              }
            </div>
            <div class="mt-5 flex flex-wrap gap-4 text-xs text-slate-500">
              <span>{fp.forks} Forks</span>
              <span>{fp.stars} Stars</span>
              <span>{fp.updatedLabel}</span>
            </div>
          </div>

          <div>
            <h4 class="text-sm font-semibold text-slate-900">Features</h4>
            <ul class="mt-4 space-y-3">
              {
                fp.features.map((feature) => (
                  <li class="flex items-start gap-2 text-sm text-slate-700">
                    <span class="mt-0.5 text-[var(--color-primary)]" aria-hidden="true">✓</span>
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <img
              src={fp.screenshotUrl}
              alt="ADVP dashboard preview showing data pipeline validation"
              width="640"
              height="400"
              loading="lazy"
              class="h-full min-h-[220px] w-full object-cover object-left-top"
            />
          </div>
        </div>
      </article>
    </div>
  </section>

  <section id="experience" class="bg-[var(--color-page)] px-4 pb-20 sm:px-6 lg:px-8">
    <div class="mx-auto grid max-w-7xl gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)]">
      <div>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900">
          {siteConfig.experience.title}
        </h2>
        <p class="mt-2 text-slate-600">{siteConfig.experience.subtitle}</p>

        <div class="relative mt-10 space-y-8 pl-2">
          <div class="absolute left-8 top-3 bottom-3 w-px bg-slate-200" aria-hidden="true"></div>
          {
            siteConfig.experience.items.map((job) => (
              <div class="relative flex gap-4">
                <CompanyLogo variant={job.logo} />
                <div class="pt-1">
                  <h3 class="font-semibold text-slate-900">{job.company}</h3>
                  <p class="text-sm text-slate-600">{job.role}</p>
                  <p class="mt-1 text-xs font-medium text-slate-500">{job.period}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <aside id="contact" class="contact-card self-start rounded-3xl p-6 lg:sticky lg:top-24">
        <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-blue-600">
          ✉️
        </div>
        <h2 class="text-xl font-bold text-slate-900">{siteConfig.contactCta.title}</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">
          {siteConfig.contactCta.description}
        </p>
        <div class="mt-6 grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
          <a
            href={siteConfig.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-[var(--color-primary)] px-4 py-2.5 text-sm font-medium text-white hover:bg-[var(--color-primary-hover)]"
          >
            {siteConfig.contactCta.linkedinLabel}
          </a>
          <a
            href={siteConfig.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white hover:bg-slate-800"
          >
            {siteConfig.contactCta.githubLabel}
          </a>
          <a
            href={siteConfig.emailMe}
            class="inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm font-medium text-slate-800 hover:bg-slate-50"
          >
            {siteConfig.contactCta.emailLabel}
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
