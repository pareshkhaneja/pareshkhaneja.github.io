---
import type { ProjectRepo } from "@/lib/github";
import { formatUpdated } from "@/lib/github";

interface Props {
  project: ProjectRepo;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article
  class="flex h-full flex-col rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] p-5 backdrop-blur-sm"
>
  <div class="mb-3 flex items-start justify-between gap-3">
    <h3 class="font-semibold tracking-tight">
      <a
        href={project.html_url}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--color-accent)]"
      >
        {project.name}
      </a>
    </h3>
    {
      featured ? (
        <span
          class="rounded-full bg-[var(--color-accent)]/15 px-2 py-0.5 text-xs font-medium text-[var(--color-accent)]"
        >
          Featured
        </span>
      ) : null
    }
  </div>
  <p class="mb-4 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">
    {project.description ?? "Open-source project on GitHub."}
  </p>
  <dl class="grid grid-cols-2 gap-2 text-xs text-[var(--color-muted)]">
    <div>
      <dt class="font-medium text-[var(--color-foreground)]">Language</dt>
      <dd>{project.language ?? "—"}</dd>
    </div>
    <div>
      <dt class="font-medium text-[var(--color-foreground)]">Updated</dt>
      <dd>{formatUpdated(project.pushed_at)}</dd>
    </div>
  </dl>
</article>
